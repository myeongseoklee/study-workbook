# 이 파일을 .env 로 복사한 뒤 실제 값을 채우세요 (cp .env.example .env)
# .env 는 .gitignore 에 포함되어 커밋되지 않습니다.

# --- 기본 provider: Google Gemini (무료 티어) ---
# 무료 키 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=여기에-Gemini-키

# 사용할 모델 (선택). 무료 티어에서 쓸 수 있는 flash 계열로.
MODEL=gemini-2.5-flash

# --- OpenAI 본토로 바꾸려면 (선택) ---
# LLM_BASE_URL 을 비우고(주석 유지) 아래 두 줄을 설정:
# OPENAI_API_KEY=sk-...
# MODEL=gpt-4o-mini
# LLM_BASE_URL=            # 비우면 OpenAI 기본 엔드포인트

# --- Claude(cc)는 08장 provider 추상화 연습문제에서 어댑터로 사용 ---
# ANTHROPIC_API_KEY=sk-ant-...
