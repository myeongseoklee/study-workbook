# 이 파일을 .env 로 복사한 뒤 실제 값을 채우세요 (cp .env.example .env)
# .env 는 .gitignore 에 포함되어 커밋되지 않습니다.

# --- 기본 provider: Google Gemini (무료 티어) ---
# 무료 키 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=여기에-Gemini-키

# 사용할 Gemini 모델 (선택). ⚠️ gemini-2.5-* 는 신규 계정엔 제공되지 않아 404가 난다.
# 현행 flash 계열을 쓸 것: gemini-3.1-flash-lite (기본) / gemini-flash-lite-latest / gemini-3.5-flash
GEMINI_MODEL=gemini-3.1-flash-lite

# --- OpenAI 본토로 바꾸려면 (선택) ---
# LLM_BASE_URL 을 비우고 아래를 설정:
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# LLM_BASE_URL=            # 비우면 OpenAI 기본 엔드포인트

# --- Claude(cc)는 08장 provider 추상화 연습문제에서 어댑터로 사용 ---
# LLM_PROVIDER=gemini        # gemini(기본) | anthropic — npm run infra:provider 가 읽는다
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5

# ⚠️ 여기 값들은 모두 src/shared/env.ts 에서만 읽는다(유일한 dotenv 주입 지점).
#    새 환경변수를 추가하면 그 파일에 export 를 하나 더 만들고, 실습 코드는 그 값을 import 한다.
